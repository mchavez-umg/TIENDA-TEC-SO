# Plantilla de variables de entorno de TIENDA-TEC.
# Copiar a .env (o ejecutar ./generar-env.sh) y reemplazar los valores. .env NUNCA se sube a Git.

# Dominio publico (sin https://), configurado en Cloudflare
DOMINIO=midominio.com

# Oracle: usuarios SYS/SYSTEM y usuarios del esquema
ORACLE_PASSWORD=cambiar
TIENDA_TEC_PASSWORD=cambiar
TIENDA_APP_PASSWORD=cambiar
TIENDA_ADMIN_PASSWORD=cambiar
TIENDA_CONSULTA_PASSWORD=cambiar

# Redis
REDIS_PASSWORD=cambiar

# Clave de firma de los tokens JWT (minimo 32 caracteres)
JWT_SECRET=cambiar
